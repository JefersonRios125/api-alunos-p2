# Copie este arquivo para .env, na mesma pasta de server.js.
# Substitua os valores abaixo pelas suas configuracoes reais.
# Nunca publique o .env com suas credenciais.

MONGO_URL=mongodb+srv://SEU_USUARIO:SUA_SENHA@SEU_CLUSTER.mongodb.net/
JWT_SECRET=substitua_por_uma_chave_secreta_longa_e_aleatoria

# Na versao atual, a porta 3004 e o banco nova_api_alunos
# estao definidos diretamente no server.js.
